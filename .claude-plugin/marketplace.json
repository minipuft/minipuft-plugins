{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "minipuft",
  "owner": {
    "name": "minipuft"
  },
  "metadata": {
    "description": "Claude Code plugins by minipuft",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "claude-prompts",
      "description": "Model Context Protocol (MCP) server for versioned prompt templates, multi-step workflow chains, and quality gates. Symbolic syntax: >>prompt --> >>chain @framework :: 'gate'",
      "version": "3.1.1",
      "author": {
        "name": "minipuft"
      },
      "source": {
        "source": "url",
        "url": "https://github.com/minipuft/claude-prompts-mcp.git",
        "ref": "dist"
      },
      "category": "productivity",
      "homepage": "https://github.com/minipuft/claude-prompts-mcp",
      "license": "MIT",
      "keywords": [
        "mcp",
        "prompts",
        "templates",
        "gates",
        "chains",
        "workflows"
      ],
      "strict": true
    },
    {
      "name": "codex-prompts",
      "description": "Codex CLI hooks + bundled claude-prompts MCP server: >>prompt commands, chain tracking, gate enforcement, Ralph loops",
      "version": "0.1.0",
      "author": {
        "name": "minipuft"
      },
      "source": {
        "source": "url",
        "url": "https://github.com/minipuft/codex-prompts.git"
      },
      "category": "productivity",
      "homepage": "https://github.com/minipuft/codex-prompts",
      "license": "MIT",
      "keywords": ["codex", "hooks", "mcp", "prompts", "gates", "chains"],
      "strict": true
    }
  ]
}
